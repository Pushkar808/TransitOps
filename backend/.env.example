# Server
PORT=4000
NODE_ENV=development

# Database
# Local Postgres example:
# DATABASE_URL="postgresql://transitops:transitops@localhost:5432/transitops?schema=public"
# Supabase example (Session pooler, replace [YOUR-DB-PASSWORD]):
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project (optional, for Supabase SDK usage)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# Auth
JWT_SECRET="change-this-super-secret-key-in-production"
JWT_EXPIRES_IN="1d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (license expiry reminders) - optional, uses console fallback if unset
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TransitOps <no-reply@transitops.com>"

# License reminder threshold (days)
LICENSE_REMINDER_DAYS=30
